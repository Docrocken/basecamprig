---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
    <link rel="canonical" href={canonicalURL} />
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title id="meta-title">BasecampRig - Practical Field Rigs, Overlanding & Camp Systems</title>
  <meta id="meta-desc" name="description" content="Technical breakdowns and gear configurations for reliable vehicle basecamps and off-grid setups." />
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      max-width: 820px;
      margin: 0 auto;
      padding: 2.5rem 1.5rem;
      line-height: 1.6;
      color: #24292e;
      background-color: #fcfcfd;
    }
    header { margin-bottom: 2.5rem; border-bottom: 1px solid #eaecef; padding-bottom: 1.5rem; }
    .top-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
    h1 { font-size: 2.2rem; color: #111; margin: 0; letter-spacing: -0.5px; }
    p.intro { font-size: 1.1rem; color: #555; margin-top: 0.5rem; }
    .card { background: #fff; border: 1px solid #e1e4e8; border-radius: 8px; padding: 1.5rem; box-shadow: 0 1px 4px rgba(0,0,0,0.04); }
    .card h2 { font-size: 1.3rem; margin-top: 0; margin-bottom: 1rem; color: #222; }
    ul.post-list { list-style: none; padding: 0; margin: 0; }
    li.post-item { padding: 1.1rem 0; border-bottom: 1px solid #f0f2f5; }
    li.post-item:last-child { border-bottom: none; }
    .post-title { font-size: 1.15rem; font-weight: 600; color: #0366d6; text-decoration: none; display: block; margin-bottom: 0.3rem; }
    .post-title:hover { text-decoration: underline; }
    .post-meta { font-size: 0.85rem; color: #6a737d; }
    .lang-pill { font-size: 0.8rem; background: #eef2f6; padding: 4px 10px; border-radius: 12px; color: #444; font-weight: 500; }
  </style>
</head>
<body>
  <header>
    <link rel="canonical" href={canonicalURL} />
    <div class="top-bar">
      <h1 id="ui-title">Welcome to BasecampRig</h1>
      <span id="lang-indicator" class="lang-pill">EN</span>
    </div>
    <p id="ui-intro" class="intro">Your authoritative resource for robust vehicle basecamps, power setups, and durable field gear.</p>
  </header>
  <main>
    <div class="card">
      <h2 id="ui-guides-header">Latest Guides</h2>
      <ul class="post-list">
        {posts.map((post) => (
          <li class="post-item">
            <a class="post-title" href={`/blog/${(post.id ? post.id.replace(/\.[^/.]+$/, "") : (post.slug || ""))}/`}>
              {post.data.title}
            </a>
            <div class="post-meta">
              <span>{post.data.category || "Rig Setup"}</span> • <span>{new Date(post.data.pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </main>

  <script>
    const userLang = (navigator.language || navigator.userLanguage || 'en').toLowerCase();
    if (userLang.startsWith('sv')) {
      document.documentElement.lang = 'sv';
      document.getElementById('meta-title').innerText = 'BasecampRig - Guider för fältriggar, overlanding och campingsystem';
      document.getElementById('meta-desc').setAttribute('content', 'Din resurs för robusta basläger, strömförsörjning och fältutrustning.');
      document.getElementById('ui-title').innerText = 'Welcome to BasecampRig';
      document.getElementById('ui-intro').innerText = 'Your tactical resource for field rigs, backcountry gear, vehicle basecamps, and heavy-duty setups.';
      document.getElementById('ui-guides-header').innerText = 'Latest Field Guides';
      document.getElementById('lang-indicator').innerText = 'SV';
    }
  </script>
</body>
</html>
